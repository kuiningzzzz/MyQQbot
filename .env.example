# Copy to .env for Docker Compose or native Python startup.
# For systemd, put the same values in .env.host (see deploy/myqqbot.service).
JM_CLEANUP_DELAY_SECONDS=300
PIXIV_CLEANUP_DELAY_SECONDS=300

DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Optional cloud audio (Alibaba Cloud Model Studio, Beijing pay-as-you-go key).
# Existing chat/vision continues to use DeepSeek; no local speech model is downloaded.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_AUDIO_MODEL=qwen3.8-omni-flash
AI_TTS_MODEL=qwen-audio-3.0-tts-plus
AI_TTS_VOICE=longanlingxin
AI_TTS_INSTRUCTION="用自然亲近的语气说话，像日常聊天，避免播音腔和夸张表演。"
# Optional switch overrides; normally managed in admin.
# AI_AUDIO_ENABLED=true
# AI_VOICE_ENABLED=true

# Official dsh Playwright browser. Chromium installed in the image is reused.
# Normally the enable switch is managed in admin; override only when needed.
# AI_BROWSER_ENABLED=true
# AI_BROWSER_EXECUTABLE_PATH=/absolute/path/to/chromium

# Optional endpoints. Leave these at their defaults when using DeepSeek directly.
AI_API_URL=https://api.deepseek.com
AI_DSH_API_URL=https://api.deepseek.com/anthropic
# The native search provider appends /messages (this base includes /v1).
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1

# Optional identity/local-memory overrides (normally edited in WebUI).
# AI_BOT_QQ=123456789
# AI_NICKNAME=奎大宁
# AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AI_STICKERS_ENABLED=true
